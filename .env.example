# Copy to .env and fill in real values. Never commit real credentials.

# Server Configuration
NODE_ENV=development
SERVER_PORT=3000
SERVER_HOST=localhost

# Database Configuration
DB_HOST=localhost
DB_USERNAME=your_db_user
DB_PASSWORD=your_db_password
DB_NAME=your_db_name

# Mail Configuration
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your_smtp_user
SMTP_MAIL=no-reply@example.com
SMTP_PASSWORD=your_smtp_password
RECEIVER_EMAIL=you@example.com

# Secret Keys
JWT_SECRET=change_me
SECRET_KEY=change_me

# URLs
BASE_URL=http://localhost:3000
SERVER_URL=http://localhost:3000
COINFLIP_SECRET_KEY=change_me
BANK_SYSTEM_RESET_SECRET_KEY=change_me
INTERNAL_WEBHOOK_SECRET=change_me
ADMIN_BACKEND_URL=http://localhost:4000

# OCR (deposit screenshots) - see docs/OCR_ENGINE.md
# Which engine reads the screenshots (python | google) is NOT set here: an admin with the OCR Engine
# right (super admins always have it) chooses it in the admin panel (Admin Area -> OCR Engine),
# and a change applies immediately.
# Everything below is optional and only needed if the OCR services move.
# Only the selected engine's URL is used; the defaults are the services the site already uses.
# OCR_PYTHON_URL=https://your-python-ocr-host/extract-image
# OCR_GOOGLE_URL=https://your-google-ocr-host/image_read/read_text.php
# How long to wait for the engine, in milliseconds (default 45000). Read at startup.
# OCR_TIMEOUT_MS=45000

# New-device login check (email OTP for an unknown browser). Run sql/20261123-new-device-login-otp.sql first.
NEW_DEVICE_OTP_ENABLED=false


# Email OTP for adding, deleting and changing the primary bank account.
# Run sql/20261125-account-otp-challenge-columns.sql and sql/20261125-account-activity-log.sql first.
ACCOUNT_OTP_ENABLED=false

# Google Authenticator for the new-device login. Run sql/20261126-totp.sql first.
# 64 hex characters (32 bytes), e.g. node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Keep a safe copy: if it is lost, every saved Authenticator secret becomes unreadable.
TOTP_ENC_KEY=

# Users without an email must add and verify one (login, bank account changes, withdrawal).
# Run sql/20261127-email-required.sql first.
EMAIL_REQUIRED_ENABLED=false

# One switch for every email OTP (new-device login, bank account, registration, email setup) and the
# new-device / bank-account alert emails. true or not set = emails are sent as usual. false = nothing is
# emailed; the code is still created and checked, and the server returns it as devOtp so the screen fills
# it in. With false, anyone who has a password is handed the code, so it works like turning OTP off.
EMAIL_OTP_ENABLED=true
