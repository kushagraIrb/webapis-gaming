# Copy to .env and fill in real values. Never commit real credentials.

# Server Configuration
NODE_ENV=development
SERVER_PORT=3000
SERVER_HOST=localhost

# Database Configuration
DB_HOST=localhost
DB_USERNAME=your_db_user
DB_PASSWORD=your_db_password
DB_NAME=your_db_name

# Mail Configuration
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your_smtp_user
SMTP_MAIL=no-reply@example.com
SMTP_PASSWORD=your_smtp_password
RECEIVER_EMAIL=you@example.com

# Secret Keys
JWT_SECRET=change_me
SECRET_KEY=change_me

# URLs
BASE_URL=http://localhost:3000
SERVER_URL=http://localhost:3000
COINFLIP_SECRET_KEY=change_me
BANK_SYSTEM_RESET_SECRET_KEY=change_me
INTERNAL_WEBHOOK_SECRET=change_me
ADMIN_BACKEND_URL=http://localhost:4000

# OCR (deposit screenshots) - see docs/OCR_ENGINE.md
# Which engine reads the screenshots (python | google) is NOT set here: a super admin chooses it in
# the admin panel (Admin Area -> OCR Engine), and a change applies immediately.
# Everything below is optional and only needed if the OCR services move.
# Only the selected engine's URL is used; the defaults are the services the site already uses.
# OCR_PYTHON_URL=https://your-python-ocr-host/extract-image
# OCR_GOOGLE_URL=https://your-google-ocr-host/image_read/read_text.php
# How long to wait for the engine, in milliseconds (default 45000). Read at startup.
# OCR_TIMEOUT_MS=45000
